# Production Environment Variables
# Copy this file to .env.prod and update the values with your production settings

# Application
NODE_ENV=production
PORT=3001

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=prod_personalia
DB_USER=postgres
DB_PASSWORD=your_secure_production_password_here

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_secure_redis_password_here

# Clerk Authentication (Production Keys)
CLERK_PUBLISHABLE_KEY=pk_live_your_production_publishable_key_here
CLERK_SECRET_KEY=sk_live_your_production_secret_key_here
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----\nyour_production_jwt_public_key_here\n-----END PUBLIC KEY-----"

# Logging
LOG_LEVEL=info

# SSL Configuration (if using custom SSL certificates)
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# Domain Configuration
DOMAIN=your-domain.com

# Security
# Generate secure random strings for production
SESSION_SECRET=your_secure_session_secret_here
JWT_SECRET=your_secure_jwt_secret_here

# Email Configuration (if needed)
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password

# Monitoring (optional)
SENTRY_DSN=your_sentry_dsn_here
