# Production runtime template for PRODUCTION_ENV_FILE.
# Empty values must be completed in GitLab before running deploy-production.

# Application
NODE_ENV=production
PORT=3001

# Alibaba RDS PostgreSQL
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_ACQUIRE_MS=30000
DB_POOL_IDLE_MS=10000

# Redis runs on the private Docker Compose network
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Clerk authentication
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_JWT_KEY=
CLERK_AUTHORIZED_PARTIES=https://personalia.bpkpenabur.or.id

# Logging
LOG_LEVEL=info
# Simpan hanya error ke PostgreSQL. Pilihan: info, warn, error, off.
DB_LOG_LEVEL=error

# Domain Configuration
DOMAIN=personalia.bpkpenabur.or.id
BASE_DOC_URL=https://personalia.bpkpenabur.or.id/api/uploads/docs

# Security
AUTO_SYNC_MODELS=false
SESSION_SECRET=
JWT_SECRET=
SAS_AUTO_LOGIN_SECRET=
SAS_AUTO_LOGIN_TTL_SECONDS=300
SAS_AUTO_LOGIN_NONCE_TTL_SECONDS=300
SAS_VERIFY_TOKEN_TTL_SECONDS=300
SAS_SESSION_JWT_EXPIRES_IN=1h
SAS_AUTO_LOGIN_RATE_LIMIT=30
SAS_VERIFY_RATE_LIMIT=60
AUTH_LOGIN_RATE_LIMIT=30
AUTH_REGISTER_RATE_LIMIT=20
PERSONALIA_API_KEY=

# Email Configuration (if needed)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Monitoring (optional)
SENTRY_DSN=

# Attendance import: MySQL source
ATTENDANCE_MYSQL_HOST=
ATTENDANCE_MYSQL_PORT=3306
ATTENDANCE_MYSQL_DATABASE=
ATTENDANCE_MYSQL_USER=
ATTENDANCE_MYSQL_PASSWORD=
ATTENDANCE_MYSQL_TIMEZONE=+07:00
ATTENDANCE_MYSQL_CONNECT_TIMEOUT_MS=10000
ATTENDANCE_SYNC_BATCH_SIZE=500
ATTENDANCE_SYNC_FROM_DATE=1970-01-01
ATTENDANCE_SYNC_DRY_RUN=false

# Approved leave API
LEAVE_SYNC_API_URL=
LEAVE_SYNC_API_KEY=
LEAVE_SYNC_TIMEOUT_MS=15000
LEAVE_SYNC_DRY_RUN=true
