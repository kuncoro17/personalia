# Local Development Environment Variables
# Use these values when the backend runs directly on your machine and
# Postgres/Redis are exposed from docker-compose on localhost.

# Application
NODE_ENV=development
PORT=3001

# Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=personalia
DB_USER=postgres
DB_PASSWORD=asd

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=

