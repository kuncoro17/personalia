{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2021", "DOM"],
    "moduleResolution": "node",

    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,

    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true
  },
  "include": ["src", "tests/**/*.ts", "tests/**/*.d.ts", "swagger-ui"],
  "exclude": ["node_modules", "dist", "swagger-ui"]
}
