JWT_SECRET=change-me-to-a-long-random-jwt-secret

# SAS auto-login security
SAS_AUTO_LOGIN_SECRET=change-me-to-a-long-random-sas-secret
SAS_AUTO_LOGIN_TTL_SECONDS=300
SAS_AUTO_LOGIN_NONCE_TTL_SECONDS=300
SAS_VERIFY_TOKEN_TTL_SECONDS=300
SAS_SESSION_JWT_EXPIRES_IN=1h
SAS_AUTO_LOGIN_RATE_LIMIT=30
SAS_VERIFY_RATE_LIMIT=60
AUTH_LOGIN_RATE_LIMIT=30
AUTH_REGISTER_RATE_LIMIT=20

# Server-to-server API key for Core SAS -> Personalia endpoints
PERSONALIA_API_KEY=change-me-to-a-long-random-api-key

# Logging
LOG_LEVEL=debug

# CORS (comma-separated origins)
# Include Vite dev (5173), local static/dev hosts (3000), and docker-compose frontend (3002)
CORS_ALLOWED=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002
