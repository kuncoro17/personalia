{
  "name": "personalia_hono",
  "version": "1.0.0",
  "type": "module",
  "main": "app.ts",
  "scripts": {
    "dev": "tsx watch app.ts",
    "start": "tsx src/app.ts",
    "db:sync": "node --import tsx src/scripts/sync-models.ts",
    "migrate": "node --import tsx src/scripts/migrate.ts up",
    "migrate:status": "node --import tsx src/scripts/migrate.ts status",
    "migrate:undo": "node --import tsx src/scripts/migrate.ts down",
    "migrate:create": "node --import tsx src/scripts/create-migration.ts",
    "build": "tsc",
    "lint": "eslint . --ext .ts,.js --fix",
    "lint:check": "eslint . --ext .ts,.js",
    "format": "prettier --write \"src/**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json,md}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "lint:fix": "eslint . --ext .ts,.js --fix"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@clerk/backend": "^2.0.0",
    "@clerk/express": "^1.6.0",
    "@hono/node-server": "^1.14.4",
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.1.5",
    "@prisma/client": "^6.9.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "git": "^0.1.5",
    "hono": "^4.7.11",
    "ioredis": "^5.6.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.16.0",
    "pg": "^8.16.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "pino-loki": "^2.6.0",
    "pino-pretty": "^13.0.0",
    "redis": "^5.5.6",
    "sequelize": "^6.37.7",
    "swagger-ui-dist": "^5.30.2",
    "xss": "^1.0.15",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@jest/globals": "^30.1.2",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.10.1",
    "@types/redis": "^4.0.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "@vitest/coverage-v8": "^3.2.4",
    "dotenv": "^17.2.1",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "prettier": "^3.8.0",
    "prisma": "^6.9.0",
    "ts-jest": "^29.4.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vitest": "^3.2.4"
  }
}
